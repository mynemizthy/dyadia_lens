    {
      "parameters": {
        "jsCode": "const outputRaw = $input.first().json.output || '';\nlet replyText = outputRaw;\nlet images = [];\n\ntry {\n  const parsed = JSON.parse(outputRaw.replace(/```json|```/g, '').trim());\n  if (parsed.reply || parsed.text) {\n    replyText = parsed.reply || parsed.text;\n    images = parsed.images || [];\n  }\n} catch (e) {\n  // Plain text from AI\n}\n\nreturn [{\n  json: {\n    reply: replyText,\n    images: images,\n    sessionId: $('Webhook Website Dyadia').item.json.body.sessionId || $('Webhook Website Dyadia').item.json.body.conversationId,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "node-format-code",
      "name": "Format Output Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        820,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
