# SUPABASE CONFIGURATION
# Lấy từ Supabase Dashboard: Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# CLIENT-SIDE VITE VARIABLES
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# GEMINI AI API (Tùy chọn cho tính năng AI cục bộ)
# Lấy từ Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# N8N CHATBOT WEBHOOK URL (Tùy chọn)
# Webhook URL nhận tin nhắn từ Chatbot widget
VITE_N8N_CHAT_WEBHOOK_URL=https://your-n8n-instance.com/webhook/dyadia-chat

# CỔNG CHẠY MÁY CHỦ (Mặc định: 3000)
PORT=3000
